#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
        conditional_layers {
                compatible = "zmk,conditional-layers";
                tri_layer {
                        if-layers = <1 2>;
                        then-layer = <3>;
                };
        };

        keymap {
                compatible = "zmk,keymap";

                default_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
// |  ESC |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  ENT |
// | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | SHFT |
//                    | RSE | LWR | CTL |   | SPC | ALT  | GUI |
                        display-name = "Base";
                        bindings = <
   &kp TAB   &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &kp BSPC
   &kp ESC   &kp A &kp S &kp D &kp F &kp G   &kp H &kp J  &kp K     &kp L   &kp SEMI &kp RET
   &kp LSHFT &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp RSHFT
                    &mo 2 &mo 1 &kp LCTRL   &kp SPACE &kp RALT &kp RGUI
                        >;
                };

                lower_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
// | CTL  |     |     |     |     |     |   | LFT | DWN |  UP | RGT |  "  |  '   |
// | SHFT |  `  |  `  |     |     |     |   |     |     |     |     |     | LWR  |
//                    | GUI |     | SPC |   | SPC |     | ALT |
                        display-name = "Lower";
                        bindings = <
   &kp TAB   &kp N1    &kp N2    &kp N3 &kp N4 &kp N5     &kp N6   &kp N7   &kp N8 &kp N9    &kp N0  &kp BSPC
   &kp LCTRL &none     &none     &none  &none  &none      &kp LEFT &kp DOWN &kp UP &kp RIGHT &kp DQT &kp SQT
   &kp LSHFT &kp GRAVE &kp GRAVE &none  &none  &none      &none    &none    &none  &none     &none   &mo 1
                              &kp LGUI &trans &kp SPACE   &kp SPACE &trans &kp RALT
                        >;
                };

                raise_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  !  |  "  |  \  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
// | CTL  |     |     |     |     |     |   |  -  |  +  |  [  |  ]  |  #  |  @   |
// | SHFT |  `  |     |     |     |     |   |  _  |  =  |  {  |  }  |  ~  |  |   |
//                    | GUI |     | SPC |   | SPC |     | ALT |
                        display-name = "Raise";
                        bindings = <
   &kp TAB   &kp EXCL  &kp DQT &kp BSLH &kp DLLR &kp PRCNT   &kp CARET &kp AMPS  &kp STAR &kp LPAR &kp RPAR &kp BSPC
   &kp LCTRL &none     &none   &none    &none    &none       &kp MINUS &kp PLUS  &kp LBKT &kp RBKT &kp HASH &kp AT
   &kp LSHFT &kp GRAVE &none   &none    &none    &none       &kp UNDER &kp EQUAL &kp LBRC &kp RBRC &kp TILDE &kp PIPE
                              &kp LGUI &trans &kp SPACE   &kp SPACE &trans &kp RALT
                        >;
                };

                adjust_layer {
// -----------------------------------------------------------------------------------------
// | BOOT |     |     |     |     |     |   |     |     |     |     |     |      |
// | BTCLR| BT0 | BT1 | BT2 | BT3 | BT4 |   |     |     |     |     |     |      |
// | RST  |     |     |     |     |     |   |     |     |     |     |     |      |
//                    | GUI |     | SPC |   | ENT |     | ALT |
                        display-name = "Adjust";
                        bindings = <
   &bootloader &none        &none        &none        &none        &none          &none &none &none &none &none &none
   &bt BT_CLR  &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &none &none &none &none &none &none
   &sys_reset  &none        &none        &none        &none        &none          &none &none &none &none &none &none
                                         &kp LGUI &trans &kp SPACE   &kp RET &trans &kp RALT
                        >;
                };

                extra_1 {
                        status = "reserved";
                };

                extra_2 {
                        status = "reserved";
                };
        };
};
